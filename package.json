{
	"name": "eulersquare",
	"version": "1.0.0",
	"description": "* <em>Start an</em> <b>Euler Square</b> <em>solitaire game and solve the puzzle on your own at</em>\r     * http://omerkel.github.io/eulersquare/javascript/html5/1.2/src\r     * http://omerkel.github.io/eulersquare/javascript/html5/1.1/src\r     * http://omerkel.github.io/eulersquare/javascript/html5/1.1/src/index_de.html (German language)",
	"main": "index.js",
	"directories": {
		"doc": "doc"
	},
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"test:sw": "node javascript/html5/1.2/src/test/sw.tests.node.js",
		"coverage:req:prepare": "node javascript/html5/1.2/src/test/requirements-coverage.prepare.js --browser-source file",
		"coverage:req:prepare:auto": "node javascript/html5/1.2/src/test/requirements-coverage.prepare.js --browser-source auto",
		"coverage:req:run": "npm run coverage:req:prepare:auto && npm run coverage:req -- --input javascript/html5/1.2/src/test/coverage-input.txt",
		"coverage:req": "node javascript/html5/1.2/src/test/requirements-coverage.js",
		"coverage:req:sample": "node javascript/html5/1.2/src/test/requirements-coverage.js --input javascript/html5/1.2/src/test/fixtures/harness-output.sample.txt --scope FR",
		"coverage:req:sample:nfr": "node javascript/html5/1.2/src/test/requirements-coverage.js --input javascript/html5/1.2/src/test/fixtures/harness-output.sample.txt --scope NFR",
		"coverage:req:sample:all": "npm run coverage:req:sample && npm run coverage:req:sample:nfr",
		"coverage:req:sample:json": "node javascript/html5/1.2/src/test/requirements-coverage.sample-json.js",
		"coverage:req:selftest": "node javascript/html5/1.2/src/test/requirements-coverage.selftest.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OMerkel/eulersquare.git"
	},
	"keywords": [],
	"type": "commonjs",
	"bugs": {
		"url": "https://github.com/OMerkel/eulersquare/issues"
	},
	"homepage": "https://github.com/OMerkel/eulersquare#readme",
	"devDependencies": {
		"markdownlint-cli": "^0.49.1"
	}
}
